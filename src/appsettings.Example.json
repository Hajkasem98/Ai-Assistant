{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-client-id>",
    "Audience": "api://<your-client-id>"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning",
      "AiAssistant.Api": "Information"
    }
  },
  "AllowedHosts": "*",

  "AzureOpenAI": {
    "Endpoint": "https://<your-openai-resource>.openai.azure.com/",
    "ApiKey": "<your-azure-openai-api-key>",
    "ChatDeployment": "gpt-5-mini",
    "EmbeddingDeployment": "text-embedding-3-large",
    "ApiVersion": "2025-01-01-preview"
  },

  "AzureSearch": {
    "Endpoint": "https://<your-search-resource>.search.windows.net",
    "ApiKey": "<your-azure-search-api-key>",
    "IndexName": "<your-index-name>",
    "ApiVersion": "2023-11-01",

    "ContentField": "content_text",
    "TitleField": "document_title",
    "UrlField": "sharepoint_url,content_path",
    "DocumentIdField": "content_id",
    "SharePointBaseUrl": "https://<your-tenant>.sharepoint.com/sites/<your-site>",
    "SemanticConfiguration": "<your-semantic-configuration-name>"
  }
}
